{
  "version": 1,
  "author": "Heartbeat Monitor - Advanced Virtual Prototype",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": 20,
      "left": 280,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-led",
      "id": "greenLed",
      "top": 170,
      "left": 300,
      "attrs": { "color": "green" }
    },
    {
      "type": "wokwi-resistor",
      "id": "greenResistor",
      "top": 170,
      "left": 220,
      "attrs": { "value": "220" }
    },
    { "type": "wokwi-led", "id": "redLed", "top": 230, "left": 300, "attrs": { "color": "red" } },
    {
      "type": "wokwi-resistor",
      "id": "redResistor",
      "top": 230,
      "left": 220,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": 300,
      "left": 300,
      "attrs": { "volume": "0.2" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pulseInput",
      "top": 353.9,
      "left": -0.2,
      "attrs": { "value": "50" }
    }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],
    [ "esp:D21", "oled:SDA", "blue", [] ],
    [ "esp:D22", "oled:SCL", "green", [] ],
    [ "esp:3V3", "oled:VCC", "red", [] ],
    [ "esp:GND.1", "oled:GND", "black", [] ],
    [ "esp:D25", "greenResistor:1", "green", [] ],
    [ "greenResistor:2", "greenLed:A", "green", [] ],
    [ "greenLed:C", "esp:GND.1", "black", [] ],
    [ "esp:D26", "redResistor:1", "red", [] ],
    [ "redResistor:2", "redLed:A", "red", [] ],
    [ "redLed:C", "esp:GND.1", "black", [] ],
    [ "esp:D27", "buzzer:2", "purple", [] ],
    [ "buzzer:1", "esp:GND.1", "black", [] ],
    [ "pulseInput:VCC", "esp:3V3", "red", [] ],
    [ "pulseInput:GND", "esp:GND.1", "black", [] ],
    [ "pulseInput:SIG", "esp:D34", "orange", [] ]
  ],
  "dependencies": {}
}